# Groq API Key (Get your free key at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Groq model (e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: set to 1 only on your own machine to get auto-reload and debug pages
FLASK_DEBUG=1
